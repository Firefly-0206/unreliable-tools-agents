+def claude_call(a, messages):
+    """Claude Code CLI (text protocol, no function calling, so T1 is not run with this provider). Prompts are
+    rendered exactly as for the Codex provider. Per-call cost / thinking tokens / stop reason go to `claude_meta`."""
+    with lock:
+        if a.max_api_calls is not None and api_calls[0] >= a.max_api_calls: raise BudgetExhausted()
+        api_calls[0] += 1
+    r = claude_backend.call(a.model, messages, timeout=a.timeout, max_waits=a.max_waits)
+    msg = {"role": "assistant", "content": r["content"], "reasoning_content": None}
+    return {"model": r["model"], "choices": [{"message": msg, "finish_reason": r["finish_reason"]}], "usage": r["usage"],
+            "claude_meta": r["meta"]}
 
